# ===== 校园活动与通知聚合 Agent 配置样例 =====
# 复制本文件为 .env 后按需填写；值均为示例，请勿提交真实密钥。

# 服务监听地址与端口
HOST=127.0.0.1
PORT=8000

# 学期第一周周一，用于把“第X周”换算成具体日期
SEMESTER_START=2026-08-31

# ===== LLM（OpenAI 兼容接口）配置 =====
# 是否启用 LLM Agent；false 时聊天自动降级为本地规则回复
LLM_ENABLED=true
# OpenAI 兼容接口地址，如 LM Studio http://127.0.0.1:1234/v1 或 DeepSeek https://api.deepseek.com/v1
LLM_BASE_URL=http://127.0.0.1:1234/v1
# 云端 API Key；本地 LM Studio 可留空
LLM_API_KEY=
# 模型名称
LLM_MODEL=local-model
# 单次 LLM 调用超时秒数
LLM_TIMEOUT=30

# ===== 校网抓取配置 =====
# 校网活动页地址（默认南京林业大学活动预告页）；也可配置 JSON feed，留空则用本地 feed_candidates.json
EVENT_FEED_URL=https://www.njfu.edu.cn/xsdt/index.html
# 抓取超时秒数
EVENT_FEED_TIMEOUT=8
# 校网内嵌列表抓取页数，默认只抓最新 1 页
EVENT_FEED_PAGES=1

# ===== 数据文件路径 =====
# 活动数据、抓取候选、偏好、提醒、待审核、抓取日志、兴趣推送、调用统计文件
EVENT_FILE=data/events.json
FEED_FILE=data/feed_candidates.json
PREFERENCES_FILE=data/user_preferences.json
REMINDERS_FILE=data/reminders.json
PENDING_FILE=data/pending_review.json
SCRAPE_LOG_FILE=data/scraping_log.jsonl
NOTIFICATIONS_FILE=data/notifications.json
USAGE_FILE=data/usage_stats.json

# ===== 运行限制 =====
# 单次检索最多返回活动数
MAX_RESULTS=50
# Agent 每次请求最多调用工具次数
MAX_TOOL_CALLS=10

# ===== 后台任务 =====
# 是否开启后台定时抓取及抓取间隔（秒）
AUTO_FETCH_ENABLED=false
AUTO_FETCH_INTERVAL=3600
# 是否开启后台到点提醒检查及检查间隔（秒）
AUTO_REMINDER_ENABLED=true
AUTO_REMINDER_INTERVAL=30
